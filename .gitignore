# What stays out of the repo. Secrets live only in Worker secrets
# (`wrangler secret put`); nothing below should ever be committed.

# Dependencies and build output
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Wrangler and other deploy tool state
.wrangler/
.vercel/
.netlify/
.cache/

# Local secrets and environment files, every variant
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.secret
*.secrets
secrets/
.secrets/

# Keys, certificates and service account files
*.pem
*.key
*.p8
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
service-account*.json
*-credentials.json
credentials.json
gcloud*.json

# Database dumps and local data
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# Test photos (may show students or their faces)
test-photos/
tools/test-photos/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Local working notes and tool settings
CLAUDE.md
.claude/
*.local
*.local.*
.test-build/

# Screen drawings stay out of the repo (media is never committed raw)
design/
