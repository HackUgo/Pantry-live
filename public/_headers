# Security headers for every page and file the site serves.
# Scripts only from this site, data only to this site and the Supabase
# project, no framing by other sites, camera only for this site.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tcjqrtvupiesddusclkc.supabase.co; connect-src 'self' https://tcjqrtvupiesddusclkc.supabase.co wss://tcjqrtvupiesddusclkc.supabase.co; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
